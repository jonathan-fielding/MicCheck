<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for the Mac App Store. Dev builds are sandboxed too, so they behave like the store build. -->
  <key>com.apple.security.app-sandbox</key><true/>
  <!-- The mixer's level meter reads the mic; the hardened runtime and the sandbox both block it without this. -->
  <key>com.apple.security.device.audio-input</key><true/>
  <!-- Vendor HID control interface (Realtek V7 mics) and the QuadCast S lighting interface (HID or IOUSBHost). -->
  <key>com.apple.security.device.usb</key><true/>
</dict>
</plist>
